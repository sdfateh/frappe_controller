{
  "doctype": "DocType",
  "name": "Frappe Controller Settings",
  "module": "Frappe Controller",
  "custom": 0,
  "issingle": 1,
  "track_changes": 1,
  "field_order": [
    "agent_installation_section",
    "public_controller_url",
    "agent_image_reference",
    "enrollment_token_ttl_seconds",
    "cloudflare_section",
    "cloudflare_api_token",
    "cloudflare_zone_id",
    "cloudflare_proxied",
    "aws_section",
    "aws_access_key_id",
    "aws_secret_access_key",
    "aws_region",
    "s3_section",
    "s3_bucket",
    "s3_allowed_buckets",
    "s3_allowed_prefixes",
    "s3_presigned_url_seconds",
    "s3_max_object_bytes",
    "s3_max_restore_bytes"
  ],
  "fields": [
    {"fieldname": "agent_installation_section", "label": "Agent Installation", "fieldtype": "Section Break"},
    {"fieldname": "public_controller_url", "label": "Public Controller URL", "fieldtype": "Data", "description": "HTTPS URL used by managed servers, for example https://controller.example.com"},
    {"fieldname": "agent_image_reference", "label": "Agent Image Reference", "fieldtype": "Data", "description": "Immutable image, for example kaleam/frappe-deploy-agent@sha256:..."},
    {"fieldname": "enrollment_token_ttl_seconds", "label": "Enrollment Token Lifetime (seconds)", "fieldtype": "Int", "default": "600"},
    {"fieldname": "cloudflare_section", "label": "Cloudflare DNS", "fieldtype": "Section Break"},
    {"fieldname": "cloudflare_api_token", "label": "Cloudflare API Token", "fieldtype": "Password"},
    {"fieldname": "cloudflare_zone_id", "label": "Cloudflare Zone ID", "fieldtype": "Password"},
    {"fieldname": "cloudflare_proxied", "label": "Proxy DNS Records", "fieldtype": "Check", "default": "0"},
    {"fieldname": "aws_section", "label": "AWS Credentials", "fieldtype": "Section Break"},
    {"fieldname": "aws_access_key_id", "label": "AWS Access Key ID", "fieldtype": "Password"},
    {"fieldname": "aws_secret_access_key", "label": "AWS Secret Access Key", "fieldtype": "Password"},
    {"fieldname": "aws_region", "label": "AWS Region", "fieldtype": "Data", "default": "us-east-1"},
    {"fieldname": "s3_section", "label": "S3 Restore Policy", "fieldtype": "Section Break"},
    {"fieldname": "s3_bucket", "label": "Default S3 Bucket", "fieldtype": "Data"},
    {"fieldname": "s3_allowed_buckets", "label": "Allowed S3 Buckets", "fieldtype": "Code", "options": "JSON", "default": "[]"},
    {"fieldname": "s3_allowed_prefixes", "label": "Allowed S3 Prefixes", "fieldtype": "Code", "options": "JSON", "default": "[\"\"]"},
    {"fieldname": "s3_presigned_url_seconds", "label": "Presigned URL Lifetime (seconds)", "fieldtype": "Int", "default": "300"},
    {"fieldname": "s3_max_object_bytes", "label": "Maximum Object Bytes", "fieldtype": "Int", "default": "21474836480"},
    {"fieldname": "s3_max_restore_bytes", "label": "Maximum Restore Bytes", "fieldtype": "Int", "default": "42949672960"}
  ],
  "permissions": [
    {"role": "Controller Admin", "read": 1, "write": 1, "create": 1, "delete": 0}
  ],
  "actions": [],
  "links": [],
  "states": []
}
