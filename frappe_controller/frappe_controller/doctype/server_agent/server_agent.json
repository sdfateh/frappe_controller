{
  "doctype": "DocType",
  "name": "Server Agent",
  "module": "Frappe Controller",
  "custom": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "autoname": "field:agent_id",
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "agent_id",
    "server_name",
    "public_ip",
    "environment",
    "enabled",
    "status",
    "protocol_version",
    "audience",
    "agent_version",
    "installation_section",
    "allowed_site_suffixes_json",
    "allowed_operations_json",
    "drain_requested",
    "drain_requested_by",
    "drain_requested_at",
    "upgrade_state",
    "desired_agent_version",
    "desired_image_digest",
    "previous_agent_version",
    "previous_image_digest",
    "observed_image_digest",
    "upgrade_requested_by",
    "upgrade_requested_at",
    "upgrade_deployed_at",
    "upgrade_verified_at",
    "upgrade_failure_code",
    "capabilities_json",
    "reported_status",
    "last_seen",
    "inventory_updated_at",
    "inventory_revision",
    "inventory_digest",
    "inventory_snapshot_json",
    "enrollment_token_hash",
    "enrollment_expires_at",
    "enrollment_token_created_at",
    "enrollment_token_created_by",
    "enrollment_consumed_at",
    "enrollment_completed_at",
    "expected_public_key_sha256",
    "signing_public_key_ed25519",
    "last_signed_request_at_ns"
