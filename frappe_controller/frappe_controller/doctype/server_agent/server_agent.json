  "fields": [
    {
      "fieldname": "agent_id",
      "label": "Agent ID",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "server_name",
      "label": "Server Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "public_ip",
      "label": "Public IPv4 Address",
      "fieldtype": "Data",
      "description": "Controller-owned DNS A records for this Agent point to this address."
    },
    {
      "fieldname": "environment",
      "label": "Environment",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "development\nstaging\nproduction"
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "reqd": 1,
      "default": "Enrolling",
      "options": "Enrolling\nOffline\nOnline\nDisabled",
      "in_list_view": 1
    },
    {
      "fieldname": "protocol_version",
      "label": "Protocol Version",
      "fieldtype": "Data",
      "reqd": 1,
      "default": "1.0"
    },
    {
      "fieldname": "audience",
      "label": "Audience",
      "fieldtype": "Data",
      "reqd": 1,
      "default": "frappe-controller"
    },
    {
      "fieldname": "agent_version",
      "label": "Agent Version",
      "fieldtype": "Data"
    },
    {"fieldname": "installation_section", "label": "Installation Policy", "fieldtype": "Section Break"},
    {"fieldname": "allowed_site_suffixes_json", "label": "Allowed Site Suffixes", "fieldtype": "Code", "options": "JSON", "default": "[]", "description": "JSON list, for example [\"kaleam.net\"]"},
    {"fieldname": "allowed_operations_json", "label": "Allowed Operations", "fieldtype": "Code", "options": "JSON", "default": "[\"site.create\",\"site.create_blank\",\"site.create_from_backup\",\"site.backup\",\"site.restore\",\"site.reinstall\",\"site.delete\",\"site.migrate\",\"site.scheduler.enable\",\"site.scheduler.disable\",\"site.maintenance.enable\",\"site.maintenance.disable\",\"site.config.update\",\"site.verify\",\"operation.cancel\"]"},
    {"fieldname": "drain_requested", "label": "Drain Requested", "fieldtype": "Check", "default": "0", "read_only": 1},
    {"fieldname": "drain_requested_by", "label": "Drain Requested By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "drain_requested_at", "label": "Drain Requested At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "upgrade_state", "label": "Upgrade State", "fieldtype": "Select", "options": "none\nplanned\ndraining\nready_to_deploy\nverifying\nsucceeded\nrollback_required\nrollback_verifying\nrolled_back\ncancelled", "default": "none", "reqd": 1, "read_only": 1},
    {"fieldname": "desired_agent_version", "label": "Desired Agent Version", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "desired_image_digest", "label": "Desired Image Digest", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "previous_agent_version", "label": "Previous Agent Version", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "previous_image_digest", "label": "Previous Image Digest", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "observed_image_digest", "label": "Observed Image Digest", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "upgrade_requested_by", "label": "Upgrade Requested By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "upgrade_requested_at", "label": "Upgrade Requested At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "upgrade_deployed_at", "label": "Upgrade Deployed At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "upgrade_verified_at", "label": "Upgrade Verified At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "upgrade_failure_code", "label": "Upgrade Failure Code", "fieldtype": "Data", "read_only": 1},
    {
      "fieldname": "capabilities_json",
      "label": "Capabilities JSON",
      "fieldtype": "Code",
      "options": "JSON",
      "default": "[]"
    },
    {
      "fieldname": "reported_status",
      "label": "Reported Status",
      "fieldtype": "Select",
      "options": "ready\ndegraded\nerror\nmaintenance",
      "read_only": 1
    },
    {
      "fieldname": "last_seen",
      "label": "Last Seen",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "inventory_updated_at",
      "label": "Inventory Updated At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "inventory_revision",
      "label": "Inventory Revision",
      "fieldtype": "Int",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "inventory_digest",
      "label": "Inventory Digest",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "inventory_snapshot_json",
      "label": "Inventory Snapshot JSON",
      "fieldtype": "Code",
      "options": "JSON",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "enrollment_token_hash",
      "label": "Enrollment Token Hash",
      "fieldtype": "Data",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "enrollment_expires_at",
      "label": "Enrollment Expires At",
      "fieldtype": "Datetime",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "enrollment_token_created_at",
      "label": "Enrollment Token Created At",
      "fieldtype": "Datetime",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "enrollment_token_created_by",
      "label": "Enrollment Token Created By",
      "fieldtype": "Data",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "enrollment_consumed_at",
      "label": "Enrollment Consumed At",
      "fieldtype": "Datetime",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "enrollment_completed_at",
      "label": "Enrollment Completed At",
      "fieldtype": "Datetime",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "expected_public_key_sha256",
      "label": "Expected Public Key SHA-256",
      "fieldtype": "Data",
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "signing_public_key_ed25519",
      "label": "Agent Signing Public Key (Ed25519)",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "last_signed_request_at_ns",
      "label": "Last Signed Request Sequence",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    }
